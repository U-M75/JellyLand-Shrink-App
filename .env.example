# JellyLand Inventory Control — environment template
# Copy this file to `.env.local` for local development:
#     copy .env.example .env.local      (Windows)
#     cp .env.example .env.local        (macOS / Linux)
#
# NEVER commit `.env.local`. Only this `.env.example` (no real secrets) belongs in GitHub.
# On Vercel, add the same names under  Project -> Settings -> Environment Variables.

# ---------------------------------------------------------------- Shopify ----
# The Admin API shop domain. This is NOT the storefront domain.
# Storefront: jellylandusa.com    Admin API: jellyland-usa.myshopify.com
VITE_SHOPIFY_STORE=jellyland-usa.myshopify.com
SHOPIFY_STORE=jellyland-usa.myshopify.com

# App credentials from the Shopify Partner / store admin (App -> API credentials).
# Used ONLY by /api/shopify-oauth and scripts/exchange-shopify-code.mjs.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional. Defaults to <origin>/api/shopify-oauth, e.g.
# http://localhost:3000/api/shopify-oauth  when running `npx vercel dev`.
# Must match EXACTLY one of the Redirect URLs allowed in the Shopify app.
SHOPIFY_OAUTH_REDIRECT_URI=http://localhost:3000/api/shopify-oauth

# Optional. Comma-separated. Defaults to the four below.
SHOPIFY_OAUTH_SCOPES=read_products,read_inventory,write_inventory,read_locations

# Long-lived Admin API token produced by:
#     node scripts/exchange-shopify-code.mjs APP_KEY APP_SECRET CODE
# Leave blank until the OAuth flow is complete.
SHOPIFY_ACCESS_TOKEN=

# --------------------------------------------------------------- Supabase ----
# Project -> Settings -> API. The URL and the public "anon" key are safe for the
# browser; the service_role key is server-side only and bypasses row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ------------------------------------------------------------------- Login ---
# Fallback shared PIN used by /api/auth when no matching staff_users row exists.
PIN_JELLYLAND=

# ------------------------------------------------------------------- Slack ---
# Optional. Only needed for the "upload report to Slack" feature.
SLACK_BOT_TOKEN=
SLACK_JELLYLAND_INVENTORY_CHANNEL=
